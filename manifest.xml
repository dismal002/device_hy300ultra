<manifest version="7.0" type="device" target-level="7">

    <!-- ====================================================== -->
    <!-- HIDL HALs (hwbinder)                                   -->
    <!-- ====================================================== -->

    <!-- Audio -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <fqname>@6.0::IDevicesFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <fqname>@6.0::IEffectsFactory/default</fqname>
    </hal>

    <!-- Bluetooth (HCI transport) -->
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IBluetoothHci/default</fqname>
    </hal>

    <!-- Boot control -->
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IBootControl/default</fqname>
    </hal>

    <!-- Graphics allocator -->
    <hal format="hidl">
        <name>android.hardware.graphics.allocator</name>
        <transport>hwbinder</transport>
        <fqname>@2.0::IAllocator/default</fqname>
    </hal>

    <!-- Graphics composer / HWC -->
    <hal format="hidl">
        <name>android.hardware.graphics.composer</name>
        <transport>hwbinder</transport>
        <fqname>@2.2::IComposer/default</fqname>
    </hal>

    <!-- Graphics mapper (passthrough) -->
    <hal format="hidl">
        <name>android.hardware.graphics.mapper</name>
        <transport arch="32+64">passthrough</transport>
        <fqname>@2.1::IMapper/default</fqname>
    </hal>

    <!-- Media codec2 -->
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IComponentStore</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Sensors -->
    <hal format="hidl">
        <name>android.hardware.sensors</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>ISensors</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Sound trigger -->
    <hal format="hidl">
        <name>android.hardware.soundtrigger</name>
        <transport>hwbinder</transport>
        <fqname>@2.3::ISoundTriggerHw/default</fqname>
    </hal>

    <!-- TV CEC -->
    <hal format="hidl">
        <name>android.hardware.tv.cec</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IHdmiCec</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- TV Input -->
    <hal format="hidl">
        <name>android.hardware.tv.input</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITvInput/default</fqname>
    </hal>

    <!-- Vendor: display config -->
    <hal format="hidl">
        <name>vendor.display.config</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IDisplayConfig</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Vendor: Allwinner TV graphics -->
    <hal format="hidl">
        <name>vendor.sunxi.tv.graphics</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IDisplay</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Vendor: Allwinner TV server -->
    <hal format="hidl">
        <name>vendor.aw.homlet.tvsystem.tvserver</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ITvServer</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- ====================================================== -->
    <!-- AIDL HALs                                              -->
    <!-- ====================================================== -->

    <!-- Bluetooth audio -->
    <hal format="aidl">
        <name>android.hardware.bluetooth.audio</name>
        <version>3</version>
        <fqname>IBluetoothAudioProviderFactory/default</fqname>
    </hal>

    <!-- CAS -->
    <hal format="aidl">
        <name>android.hardware.cas</name>
        <fqname>IMediaCasService/default</fqname>
    </hal>

    <!-- DRM - ClearKey -->
    <hal format="aidl">
        <name>android.hardware.drm</name>
        <version>1</version>
        <fqname>IDrmFactory/clearkey</fqname>
    </hal>

    <!-- DRM - Widevine -->
    <hal format="aidl">
        <name>android.hardware.drm</name>
        <version>1</version>
        <fqname>IDrmFactory/widevine</fqname>
    </hal>

    <!-- Health -->
    <hal format="aidl">
        <name>android.hardware.health</name>
        <version>2</version>
        <fqname>IHealth/default</fqname>
    </hal>

    <!-- Power -->
    <hal format="aidl">
        <name>android.hardware.power</name>
        <version>4</version>
        <fqname>IPower/default</fqname>
    </hal>

    <!-- Security: KeyMint -->
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
    </hal>

    <!-- Security: SecureClock -->
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <fqname>ISecureClock/default</fqname>
    </hal>

    <!-- Security: SharedSecret -->
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>

    <!-- USB -->
    <hal format="aidl">
        <name>android.hardware.usb</name>
        <version>2</version>
        <interface>
            <name>IUsb</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- USB Gadget -->
    <hal format="aidl">
        <name>android.hardware.usb.gadget</name>
        <version>1</version>
        <interface>
            <name>IUsbGadget</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Wi-Fi -->
    <hal format="aidl">
        <name>android.hardware.wifi</name>
        <fqname>IWifi/default</fqname>
    </hal>

    <!-- Wi-Fi hostapd -->
    <hal format="aidl">
        <name>android.hardware.wifi.hostapd</name>
        <fqname>IHostapd/default</fqname>
    </hal>

    <!-- Wi-Fi supplicant -->
    <hal format="aidl">
        <name>android.hardware.wifi.supplicant</name>
        <version>2</version>
        <fqname>ISupplicant/default</fqname>
    </hal>

    <!-- Vendor: Allwinner DRM heap allocator -->
    <hal format="aidl">
        <name>vendor.hardware.drmheapallocator</name>
        <version>1</version>
        <fqname>IDrmHeapAllocator/default</fqname>
    </hal>

    <!-- ====================================================== -->
    <!-- SEPolicy                                               -->
    <!-- ====================================================== -->
    <sepolicy>
        <version>34.0</version>
    </sepolicy>

</manifest>
